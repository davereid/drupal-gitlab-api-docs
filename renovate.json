{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "composerIgnorePlatformReqs": [
    "php",
    "ext-*",
    "lib-*"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "baseBranchPatterns": [
    "main"
  ],
  "rangeStrategy": "update-lockfile",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "A library keeps its Composer ranges; only add new major versions.",
      "matchManagers": [
        "composer"
      ],
      "rangeStrategy": "widen"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    }
  ]
}
